NODE_ENV=production
PORT=3000
# APP_URL=https://your-domain.com   # optional on Vercel (defaults to the production .vercel.app address)
DATABASE_URL=libsql://your-db-name.turso.io   # leave empty locally to use a SQLite file
DATABASE_AUTH_TOKEN=
BLOB_READ_WRITE_TOKEN=          # added automatically by Vercel when you connect a private Blob store
# PACK_STORAGE=disk             # local dev: read ZIPs from PACKS_DIR instead of Blob
# PACKS_DIR=./private/packs
SESSION_SECRET=            # openssl rand -hex 32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BREVO_API_KEY=                 # or RESEND_API_KEY (Brevo wins if both are set)
# RESEND_API_KEY=
EMAIL_FROM="Inkdrift <no-reply@your-domain.com>"
YOUPI_API_URL=https://your-youpi-payment-api.example.com
YOUPI_MERCHANT_ID=
YOUPI_MERCHANT_API_KEY=
YOUPI_WEBHOOK_SECRET=
YOUPI_UNLOCK_POLICY=observed   # observed = unlock on bank-alert match; reconciled = only after statement import
